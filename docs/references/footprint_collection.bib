}
@techreport{Neftel2008,
abstract = {This software provides an easy-to-use tool for calculating footprints after the Kormann- Meixner method (Kormann and Meixner, 2001) and combining them with landuse information. The tool was realized in Visual Basic and is provided within an MS Excel workbook, containing different sheets for handling input and output data. Starting from meteorological data readily available from standard eddy covariance measurements, the software first calculates the two-dimensional footprint density functions according to the Kormann-Meixner model (KM). This footprint is then overlaid with coordinates of quadrangular surface areas specified by the user, and each area's fraction within the footprint is computed. Additional information can be found in Neftel et al. (2008). It is also the reference to be cited when using this tool as part of publications. (Version 1.0, 13 March 2007)},
author = {Neftel, Albrecht and Spirig, Christoph and Ammann, Christof},
