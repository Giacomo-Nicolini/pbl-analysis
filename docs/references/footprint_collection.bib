@article{Lloyd1995,
abstract = {The use of gradient or eddy correlation methods for surface flux measurements has become routine in homogeneous terrain. The measurements and the methods are now increasingly being sited in heterogeneous terrain. While the methods still may be appropriate for this terrain, the interpretation of the measurements presents difficulties. In this paper the under- lying source distribution of fluxes contributing to the gradient or eddy correlation measurement is shown to be at variance with both the areal estimates of available energy and with adjacent similar measurements of surface fluxes. The recent HAPEX-Sahel experiment provides an extreme example of a natural heterogeneous surface for this modelling exercise.},
author = {Lloyd, C.R.},
doi = {10.1016/0168-1923(94)05075-H},
file = {:C\:/Users/Giacomo/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Lloyd - 1995 - The effect of heterogeneous terrain on micrometeorological flux measurements a case study from HAPEX-Sahel.pdf:pdf},
