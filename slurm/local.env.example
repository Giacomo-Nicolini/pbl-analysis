# Machine-specific SLURM settings for scripts/slurm_submit.R (spec 09 A3).
# Copy to slurm/local.env (gitignored) and fill in. Never commit slurm/local.env.
# Format: KEY=value, one per line; '#' starts a comment; quotes optional. Empty value = line dropped from the job script.

SLURM_PARTITION=partition_name
SLURM_MAIL_USER=
SLURM_MAIL_TYPE=FAIL
# Site steps (01, 11a, 02, 04, 08a): one R process per site
SITES_CPUS_PER_TASK=1
SITES_MEM=16G
# Footprint chunks (08b): the job's CPUs are the workers of the chunk
CHUNK_CPUS_PER_TASK=2
CHUNK_MEM_PER_CPU=4G
# Wall time (empty = partition default) and maximum simultaneous tasks per array (empty = no limit)
SLURM_TIME=
SLURM_ARRAY_MAX=
# Maximum tasks per array (below the cluster's MaxArraySize, 1001); longer chunk lists become several arrays
SLURM_MAX_ARRAY_TASKS=1000
# Shell line(s) run before Rscript, e.g. a module load; separate several with ';'
R_SETUP=
R_CONFIG_ACTIVE=cluster
# Clone of the repository and folder for the SLURM .out files
PROJECT_DIR=/path/to/dev/pbl-analysis
LOG_DIR=/path/to/slurm_logs
